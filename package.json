{
  "name": "qsk-breves-automaticas",
  "version": "1.0.0",
  "description": "Extractor y normalizador automatizado de gacetillas y feeds oficiales para QSK Noticias",
  "main": "index.js",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "extraer": "node --use-system-ca src/index.ts",
    "test": "vitest run",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "ole": "node --use-system-ca src/ole/run.ts"
  },
  "keywords": [
    "scraper",
    "gacetillas",
    "buenos-aires",
    "qsk-noticias",
    "rss",
    "automation"
  ],
  "author": "Axel Quiroga",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AxelQuiroga/qsk-breves-automaticas.git"
  },
  "type": "module",
  "dependencies": {
    "cheerio": "^1.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
